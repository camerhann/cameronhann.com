---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../lib/site';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base>
  <h1>Chris Cameron-Hann</h1>
  <p class="lede">
    I build flood models, software, and teams. This is my site — writing on the work, and other things
    I want to think through in public.
  </p>
  <p>
    Day job is CTO at <a href="https://aegaea.com">Aegaea</a> and
    <a href="https://7analytics.ai">7Analytics</a>. I also build
    <a href="https://hydrometric.io">hydrometric.io</a>. The short version of anything here goes on X.
  </p>

  <hr class="rule" />

  <h2 class="section-label">Writing</h2>
  {
    posts.length === 0 ? (
      <p class="muted">Nothing published yet.</p>
    ) : (
      <ul class="writing-list">
        {posts.map((post) => (
          <li>
            <a href={`/writing/${post.id}`}>
              <span class="writing-title">{post.data.title}</span>
              <span class="writing-meta">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              </span>
              <span class="writing-dek">{post.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Base>
